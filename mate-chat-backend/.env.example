# MATE CHAT Backend Environment Configuration
APP_NAME="MATE CHAT"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.matechat.app
APP_SECRET=your_32_character_random_app_secret_here

# Database Configuration (MySQL 8+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mate_chat
DB_USERNAME=mate_user
DB_PASSWORD=your_secure_mysql_password_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_min_64_chars_recommended
JWT_EXPIRATION_SECONDS=86400
REFRESH_TOKEN_EXPIRATION_DAYS=30

# WebSocket Configuration
WS_HOST=0.0.0.0
WS_PORT=8080
WS_PUBLIC_URL=wss://api.matechat.app/ws

# Firebase Cloud Messaging (HTTP v1)
FCM_PROJECT_ID=mate-chat-production
FCM_SERVICE_ACCOUNT_PATH=/secure/credentials/firebase-service-account.json

# WebRTC STUN/TURN Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=turn:turn.matechat.app:3478
TURN_USERNAME=mate_turn_user
TURN_CREDENTIAL=mate_turn_secret_token

# Storage & Security
STORAGE_PATH=storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800
ENFORCE_E2EE=true
